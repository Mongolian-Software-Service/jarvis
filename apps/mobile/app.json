{
  "expo": {
    "name": "TsStark Academy",
    "slug": "tsstark-academy",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tsstark",
    "newArchEnabled": true,
    "userInterfaceStyle": "dark",
    "backgroundColor": "#08090a",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "mn.tsstark.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "mn.tsstark.app",
      "adaptiveIcon": {
        "backgroundColor": "#08090a",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-video",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#08090a",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 72
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c6a30d69-bf69-492c-ba08-c99558c05537"
      }
    },
    "owner": "tsstark"
  }
}
