# ─────────────────────────────────────────────────────────────────────────────
# Jarvis — environment contract.
#
# Copy to apps/web/.env.local for local work. Every name here is also listed in
# turbo.json's build `env` array; a variable missing from that array is not
# passed to the Vercel build however carefully it was set in the dashboard.
#
# Values are left empty on purpose. This file is committed — nothing with a
# real value in it belongs here.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API. The publishable (anon) key is safe in a browser
# bundle — RLS is what protects the data. The secret key is NOT: it bypasses
# RLS entirely and is read in exactly one file (lib/supabase/server.ts).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ── This app ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Bonum (payments) ────────────────────────────────────────────────────────
# test        https://testapi.bonum.mn
# production  https://apis.bonum.mn
#
# BONUM_MOCK=1 skips the gateway entirely and settles the invoice locally, so
# the whole purchase → enrollment path can be walked without a merchant
# account. It is ignored when NODE_ENV=production.
BONUM_MOCK=1
BONUM_API_BASE_URL=https://testapi.bonum.mn
BONUM_APP_SECRET=
BONUM_TERMINAL_ID=
BONUM_MERCHANT_CHECKSUM_KEY=
BONUM_CALLBACK_URL=

# ── Mobile (apps/mobile) ────────────────────────────────────────────────────
# Anything an Expo bundle reads must be EXPO_PUBLIC_*, and anything EXPO_PUBLIC_*
# is shipped to the device in cleartext. No secret ever goes in this group.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_API_URL=http://localhost:3000
