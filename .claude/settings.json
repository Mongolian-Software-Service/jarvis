{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '(.tool_response.filePath // .tool_input.file_path) // empty' | { read -r f; [ -n \"$f\" ] || exit 0; case \"$f\" in *.ts|*.tsx|*.js|*.jsx|*.mjs|*.json|*.css|*.md) pnpm exec prettier --write --ignore-unknown \"$f\";; esac; } >/dev/null 2>&1 || true",
            "timeout": 30,
            "statusMessage": "Formatting…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if ! out=$(pnpm typecheck 2>&1 && pnpm lint 2>&1); then printf '%s' \"$out\" | jq -Rs '{decision:\"block\", reason:(\"Typecheck/lint failed — fix before finishing: \" + .)}'; fi",
            "timeout": 180,
            "statusMessage": "Typecheck + lint…"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(node *)",
      "Bash(jq *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(supabase migration new *)",
      "Bash(supabase db diff *)"
    ],
    "deny": [
      "Read(./apps/web/.env.local)",
      "Read(./.env)"
    ]
  }
}
